# Salin ke .env untuk jalan lokal. Di Vercel, isi ini di
# Settings > Environment Variables (bukan lewat .env).

# Wajib
KALPA_GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
KALPA_SESSION_SECRET=tempel-string-acak-yang-panjang-di-sini

# Hanya kalau CONFIG.TOKEN di Code.gs diisi
KALPA_GAS_TOKEN=

# Server lokal, diabaikan Vercel
PORT=3000
HOST=0.0.0.0

# Perilaku, semua opsional (default ditampilkan)
KALPA_REQUIRE_LOGIN=yes
KALPA_SESSION_HOURS=12
KALPA_MAX_FAILED_LOGINS=5
KALPA_LOCKOUT_MINUTES=30
KALPA_CACHE_SECONDS=6
KALPA_TIMEOUT_SECONDS=45
# auto, true, atau false. Pakai false hanya untuk uji http lokal.
KALPA_COOKIE_SECURE=auto
